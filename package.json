{
	"name": "pi-collections",
	"version": "0.1.0",
	"description": "Private npm workspace for developing pi extensions (root is a dev wrapper only, never published)",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tangentyh/pi-collections.git"
	},
	"workspaces": [
		"extensions/*"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "npm test --workspaces",
		"start:scroll-speed": "pi -e ./extensions/scroll-speed/scroll-speed.ts",
		"start:cursor": "pi -e ./extensions/focus-aware-blinking-cursor-and-border/focus-aware-blinking-cursor-and-border.ts",
		"start:footer-template": "pi -e ./extensions/footer-template/footer-template.ts",
		"start:deepseek-pricing-by-time": "pi -e ./extensions/deepseek-pricing-by-time/deepseek-pricing-by-time.ts",
		"start:sticky-last-prompt": "pi -e ./extensions/sticky-last-prompt/sticky-last-prompt.ts",
		"start:working-timer": "pi -e ./extensions/working-timer/working-timer.ts",
		"start:auto-rename": "pi -e ./extensions/auto-rename/auto-rename.ts",
		"start:system-prompt-trim": "pi -e ./extensions/system-prompt-trim",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "^0.85.1",
		"@types/node": "^22.20.5",
		"husky": "^9.1.7",
		"typebox": "^1.4.3",
		"typescript": "^5.5.0"
	}
}
