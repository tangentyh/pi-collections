{
  "name": "pi-collections",
  "version": "0.1.0",
  "description": "Pi extension monorepo",
  "keywords": ["pi-package", "pi-extension"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangentyh/pi-collections.git"
  },
  "workspaces": ["extensions/*"],
  "pi": {
    "extensions": [
      "./extensions/scroll-speed/scroll-speed.ts",
      "./extensions/focus-aware-blinking-cursor-and-border/focus-aware-blinking-cursor-and-border.ts"
    ]
  },
  "files": ["extensions/", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start:scroll-speed": "pi -e ./extensions/scroll-speed/scroll-speed.ts",
    "start:cursor": "pi -e ./extensions/focus-aware-blinking-cursor-and-border/focus-aware-blinking-cursor-and-border.ts",
    "prepublishOnly": "npm run typecheck"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.11",
    "typescript": "^5.5.0"
  }
}
