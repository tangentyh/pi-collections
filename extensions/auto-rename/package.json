{
	"name": "@tangentyh/pi-auto-rename",
	"version": "0.1.0",
	"description": "Auto-generate names for your pi session and the terminal surfaces it runs in (tmux window, herdr pane/tab, zellij pane/tab) so it is easy to see what each pi is doing. Fork of @normful/pi-auto-name with subagent-surface and config-location fixes planned",
	"keywords": [
		"pi-package",
		"pi-extension",
		"auto-rename",
		"session-name",
		"tmux",
		"zellij",
		"herdr",
		"fork"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tangentyh/pi-collections.git",
		"directory": "extensions/auto-rename"
	},
	"homepage": "https://github.com/tangentyh/pi-collections/tree/main/extensions/auto-rename",
	"type": "module",
	"pi": {
		"extensions": [
			"./auto-rename.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p ../..",
		"test": "echo \"no tests\"",
		"prepublishOnly": "npm run typecheck"
	},
	"dependencies": {
		"@juicesharp/rpiv-config": "^2.3.1",
		"typebox": "^1.3.11"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "^0.85.1",
		"@types/node": "^22.0.0",
		"typescript": "^5.5.0"
	},
	"files": [
		"auto-rename.ts",
		"config.ts",
		"context.ts",
		"debug.ts",
		"dedup.ts",
		"i18n.ts",
		"locales.ts",
		"naming.ts",
		"ownership.ts",
		"sanitize.ts",
		"state.ts",
		"surfaces.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	]
}
