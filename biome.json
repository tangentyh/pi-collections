{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"files": {
		"includes": ["**", "!archive"]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	}
}
